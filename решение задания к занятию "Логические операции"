using System;

class Program
{
    static void Main()
    {
      
        Console.WriteLine("Enter the first number:");

        if (!int.TryParse(Console.ReadLine(), out int a))
        {
         
            Console.WriteLine("Error! First number is invalid.");
            return; 
        }

    
        Console.WriteLine("Enter the second number:");

        if (!int.TryParse(Console.ReadLine(), out int b))
        {
            Console.WriteLine("Error! Second number is invalid.");
            return;
        }

             Console.WriteLine("Enter the operator (&, |, ^):");

        string input = Console.ReadLine()?.Trim() ?? "";

     
        if (input.Length != 1 || (input[0] != '&' && input[0] != '|' && input[0] != '^'))
        {
            Console.WriteLine("Error! Operator must be one of: & | ^");
            return;
        }

        char op = input[0];

              int result;

        switch (op)
        {
            case '&':
              
                result = a & b;
                break;

            case '|':
               
                result = a | b;
                break;

            case '^':
               
                result = a ^ b;
                break;

            default:
                
                Console.WriteLine("Error! Unknown operator.");
                return;
        }

        Console.WriteLine();
        Console.WriteLine($"Decimal:     {result}");           
        Console.WriteLine($"Binary:      {Convert.ToString(result, 2)}");
        Console.WriteLine($"Hexadecimal: 0x{result:X}");     
    }
}
